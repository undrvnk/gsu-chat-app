# Production service: gunicorn behind nginx (nginx serves port 80).
#
# Install:
#   bash scripts/setup-nginx.sh

[Unit]
Description=GSU CS Grad Portal (gunicorn)
After=network.target

[Service]
Type=simple
User=jason
WorkingDirectory=/home/jason/gsu-chat-app
Environment=FLASK_DEBUG=0
EnvironmentFile=-/home/jason/gsu-chat-app/.env
ExecStartPre=/usr/bin/python3 -c 'import app; app.init_db()'
ExecStart=/usr/bin/gunicorn --chdir /home/jason/gsu-chat-app --bind 127.0.0.1:8000 --workers 2 --threads 4 --timeout 120 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
